# Copy this file to .env before running Docker Compose or the Rust server locally.

# Required. Use a private random value of at least 32 bytes. Keep the same value
# when upgrading: it also protects linked Jellyfin tokens.
JWT_SECRET=change-me-to-a-private-random-secret-at-least-32-bytes

# Docker storage. The default named volume preserves the SQLite database, cache,
# and migration backups. For a bind mount, use an absolute host path instead.
TUNEFLOW_DATA_HOST_PATH=tuneflow-data
# Docker runs the API as this UID/GID. Match ownership for a bind mount.
PUID=10001
PGID=10001

# Host ports. The API listens on port 8000 inside its container; the web app
# listens on port 80. Changing these values does not change container ports.
API_PORT=8010
WEB_PORT=3010

# Leave empty to make the web app use its same-origin /api proxy. Set a URL only
# when browsers must reach the API at a separate address. Rebuild web after edits.
VITE_API_URL=
# For a separate API origin, set this to the public web origin, e.g.
# CORS_ORIGINS=https://music.example.com
CORS_ORIGINS=

# Trusted Jellyfin addresses that users may link. JELLYFIN_URL is also shown as
# the default in Settings. At least one of these must be set to enable new links.
# Addresses must be reachable from the API container; include any subpath.
JELLYFIN_URL=
# JELLYFIN_ALLOWED_URLS=https://other-jellyfin.example.com

# Rust server settings. Compose overrides TUNEFLOW_DATA_DIR to /app/data.
# BIND_ADDRESS should stay at 0.0.0.0:8000 when using the Compose port mapping.
TUNEFLOW_DATA_DIR=data
BIND_ADDRESS=0.0.0.0:8000
YTDLP_BIN=yt-dlp
RUST_LOG=tuneflow_server=info,tower_http=info

# Optional OpenAI-compatible recommendations. Set enabled, URL, and model;
# add an API key only if your provider requires one.
LLM_ENABLED=false
# LLM_BASE_URL=http://your-llm-host:11434/v1
# LLM_MODEL=your-model
# LLM_API_KEY=

# Optional Spotify playlist import.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional Last.fm / Libre.fm scrobbling.
# SCROBBLER_LASTFM_API_KEY=
# SCROBBLER_LASTFM_API_SECRET=
# SCROBBLER_LIBREFM_API_KEY=
# SCROBBLER_LIBREFM_API_SECRET=

# Optional shared network for an existing reverse proxy. Create it first, then
# use compose.sh or compose.ps1 so the network overlay is included.
# DOCKER_SHARED_NETWORK=nginx_network
